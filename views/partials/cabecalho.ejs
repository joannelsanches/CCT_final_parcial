<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof titulo !== 'undefined' ? titulo + ' | StartIF' : 'StartIF' %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="container nav">
        <a class="logo" href="/"><span>StartIF</span></a>
        <% if (!usuarioLogado) { %>
          <a class="btn btn-small login-button mobile-login" href="/login">Entrar</a>
        <% } %>
        <button
          class="menu-toggle"
          type="button"
          data-menu
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="menu-principal"
        >
          Menu
        </button>
        <nav class="nav-links" id="menu-principal" aria-label="Navegação principal">
          <% if (!usuarioLogado) { %>
            <a href="/">Início</a>
            <a href="/vagas">Vagas</a>
            <a href="/cadastro">Cadastre-se</a>
            <a class="btn btn-small login-button" href="/login">Entrar</a>
          <% } else { %>
            <%- include('./menu-usuario', { usuario: usuarioLogado }) %>
            <a href="/preferencias/notificacoes">Preferências</a>
            <a href="/notificacoes" class="nav-notifications">
              Notificações
              <% if (notificacoesNaoLidas > 0) { %>
                <span
                  class="notification-count"
                  aria-label="<%= notificacoesNaoLidas %> notificações não lidas"
                ><%= notificacoesNaoLidas > 99 ? '99+' : notificacoesNaoLidas %></span>
              <% } %>
            </a>
            <a href="/conta/acesso">Conta e acesso</a>
            <%- include('./avatar-usuario', {
              usuario: usuarioLogado,
              avatar: typeof avatarUsuario === 'undefined' ? {} : avatarUsuario
            }) %>
            <form action="/logout" method="post">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              <button class="link-button" type="submit">Sair</button>
            </form>
          <% } %>
        </nav>
      </div>
    </header>
    <main id="conteudo-principal" tabindex="-1" class="<%= typeof classeMain !== 'undefined' ? classeMain : '' %>">
      <% if (mensagem) { %>
        <div class="container">
          <div class="alert <%= mensagem.tipo %>" role="alert"><%= mensagem.texto %></div>
        </div>
      <% } %>
